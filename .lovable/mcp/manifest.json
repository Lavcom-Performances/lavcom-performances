{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "lavcom-performances-mcp",
      "version": "0.1.0",
      "title": "Lavcom Performances MCP"
    },
    "tools": [
      {
        "name": "ping",
        "title": "Ping",
        "description": "Verify connectivity to the Lavcom Performances MCP server. Returns a pong with an optional echoed message and the server timestamp.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "maxLength": 200,
              "description": "Optional message echoed back in the response."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
