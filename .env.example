# ============================================
# Lavcom Performances - Environment Variables
# ============================================
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` to version control.
# This file is safe to commit: it contains only variable names and placeholders.

# ---------------------------------------------------------------------------
# Application Vite (public, exposed in the browser bundle)
# These variables are prefixed with VITE_ and embedded at build time.
# They are NOT secret: only use public keys and URLs here.
# ---------------------------------------------------------------------------

# Supabase project URL (public, used by the browser client)
# Example: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=""

# Supabase public / anon key (used by the browser client)
# This key is safe to expose in the browser because Row Level Security (RLS) protects data.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Supabase project ID (used for CLI tooling, not read directly by the app)
# Example: abcdefghijklmnopqrst
VITE_SUPABASE_PROJECT_ID=""

# Stripe mode: "test" or "live"
# Determines which Stripe API key set is used by the checkout flows.
VITE_STRIPE_MODE="test"

# Stripe public publishable key (test or live, depending on VITE_STRIPE_MODE)
# Example: pk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=""

# Development mode flag: "true" or "false"
# Enables extra logging and dev helpers in some components.
VITE_DEV_MODE="false"

# ---------------------------------------------------------------------------
# Backend / Edge Function secrets
# Configure these in Lovable Cloud Secrets (not in the browser .env).
# They are read by Supabase Edge Functions via Deno.env.get().
# ---------------------------------------------------------------------------

## Supabase internal secrets

# Supabase project URL (same value as VITE_SUPABASE_URL, for Edge Functions)
SUPABASE_URL=""

# Supabase public / anon key (same value as VITE_SUPABASE_PUBLISHABLE_KEY, for Edge Functions)
SUPABASE_ANON_KEY=""

# Supabase service role key (SERVER-ONLY, NEVER expose to the browser)
# Grants admin access bypassing RLS; use only inside Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=""

## Email delivery (Resend)

# Resend API key for sending transactional emails
RESEND_API_KEY=""

# From address used by transactional emails
# Example: "Lavcom <noreply@lavcom.fr>"
RESEND_FROM_EMAIL=""

# Default destination address for admin notification emails
# Example: contact@lavcom.fr
RESEND_TO_EMAIL=""

## Payments (Stripe)

# Stripe secret key (SERVER-ONLY)
# Example: sk_test_... or sk_live_...
STRIPE_SECRET_KEY=""

# Stripe webhook endpoint secret (used to validate webhook signatures)
# Example: whsec_...
STRIPE_WEBHOOK_SECRET=""

## Cron & automation

# Secret token used to authenticate scheduled cron jobs
CRON_SECRET=""

## Site / app metadata

# Canonical public URL of the application, used in emails and redirects
# Example: https://app.lavcom.fr
APP_BASE_URL=""

# Alternative canonical URL, used by some Edge Functions
# Keep APP_BASE_URL and SITE_URL in sync when both are required.
SITE_URL=""

# Environment label ("staging", "production", "development")
# Used in logs and some edge function branches.
ENVIRONMENT="staging"

# ---------------------------------------------------------------------------
# Optional secrets and integrations
# ---------------------------------------------------------------------------

# Slack webhook URL for critical alerts (leave empty to disable Slack alerts)
SLACK_WEBHOOK_URL=""

# Comma-separated UUIDs of demo sites allowed to run DR drills
# Example: "11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222"
DEMO_SITE_ID_ALLOWLIST=""

# ScreenshotOne API key for automated DR drill screenshots
SCREENSHOTONE_API_KEY=""

# INSEE SIRENE API key for French SIRET company lookup
SIRENE_API_KEY=""

# Secret token for the backup system callback endpoint
BACKUP_CALLBACK_SECRET=""

# GitHub personal access token for repository-based backup operations
GITHUB_PAT=""

# GitHub repository slug for backup operations
# Example: owner/repo
GITHUB_REPO=""

# Admin email address for security alerts
ADMIN_ALERT_EMAIL=""

# Lovable AI Gateway key (used only by server-side Edge Functions; never in the browser)
LOVABLE_API_KEY=""

# ---------------------------------------------------------------------------
# Local development / tests only
# These variables are read by local scripts and smoke tests.
# ---------------------------------------------------------------------------

# Test account credentials (used by scripts/qa/smoke.ts)
TEST_USER_A_EMAIL=""
TEST_USER_A_PASSWORD=""
TEST_USER_B_EMAIL=""
TEST_USER_B_PASSWORD=""

# Node environment ("development", "test", "production")
NODE_ENV="development"
